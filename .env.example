# Exemplo de variáveis de ambiente para conexão com o Firebase.
# Renomeie este arquivo para .env ou .env.local e substitua pelos valores do seu projeto.
# Caso essas variáveis não sejam definidas, o SolarCRM funcionará em modo MockDB (dados salvos localmente).

VITE_FIREBASE_API_KEY=SUA_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=seu-projeto
VITE_FIREBASE_STORAGE_BUCKET=seu-projeto.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
